# Household calculator endpoint (Modal; scripts/modal_household_api.py).
# Production: https://policyengine--ballot-measures-2026-household-householdapi-web.modal.run (the default)
# Previews:   https://policyengine--bm26-household-preview-householdapi-web.modal.run
# Copy this file to .env.local for local development, and set the variable
# per environment in Vercel.
NEXT_PUBLIC_HOUSEHOLD_API_URL=https://policyengine--bm26-household-preview-householdapi-web.modal.run

# Folder under public/ with the results files. Defaults to "data" (the
# pipeline's output). "data-fixtures" serves synthetic files
# (node scripts/make-fixtures.mjs) and shows a "Placeholder data" banner.
# Never set this in production.
# NEXT_PUBLIC_DATA_DIR=data-fixtures

# Base path the app is served under. Defaults to /us/ballot-measures-2026;
# set to an empty string to serve from the site root in local development.
# NEXT_PUBLIC_BASE_PATH=
